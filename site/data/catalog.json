  },
  "metrics": [
    {
      "name": "plans_active",
      "file": "metrics/plans_active.yml",
      "question": "How many active plan subscriptions do we have??",
      "source": "data/model/fct_subscription.csv",
      "aggregation": "count of subscription_id",
      "filters": [
        "is_test_account = false",
        "status = active"
      ],
      "conditions": [
        {
          "column": "is_test_account",
          "equals": "false"
        },
        {
          "column": "status",
          "equals": "active"
        }
      ],
      "group_by": [
        "business_id",
        "plan_tier",
        "billing_cycle"
      ],
      "dimensions": [
        "business_id",
        "plan_tier",
        "billing_cycle"
      ],
      "notes": [
        "Count subscription rows. A person with two active subscriptions counts twice.",
        "Use the governed status column. A status of unknown is not active.",
        "Take subscription counts from this table. subscription_start events are not plans."
      ],
      "cube": "data/cubes/plans_active.json",
      "total": 444,
      "by_business": [
        {
          "id": "BIZ_1",
          "short": "PageGarden",
          "value": 137
        },
        {
          "id": "BIZ_2",
          "short": "GatherSquare",
          "value": 158
        },
        {
          "id": "BIZ_3",
          "short": "MakerHarbor",
          "value": 149
        }
      ]
    },
    {
      "name": "subscribers_active",
      "file": "metrics/subscribers_active.yml",
      "question": "How many users hold an active subscription?",
      "source": "data/model/fct_subscription.csv",
      "aggregation": "count distinct user_id",
      "filters": [
        "is_test_account = false",
        "status = active"
      ],
      "conditions": [
        {
          "column": "is_test_account",
          "equals": "false"
        },
        {
          "column": "status",
          "equals": "active"
        }
      ],
      "group_by": [
        "business_id"
      ],
      "dimensions": [
        "business_id"
      ],
      "notes": [
        "Count people, not subscription rows. plans_active counts the rows.",
        "Recompute the distinct count at every grain. Adding the business totals double-counts a person who is active in more than one business.",
        "Use the governed status column. A status of unknown is not active."
      ],
      "cube": "data/cubes/subscribers_active.json",
      "total": 389,
      "by_business": [
        {
          "id": "BIZ_1",
          "short": "PageGarden",
          "value": 125
        },
        {
          "id": "BIZ_2",
          "short": "GatherSquare",
          "value": 147
        },
        {
          "id": "BIZ_3",
          "short": "MakerHarbor",
          "value": 145
        }
      ],
      "business_totals_sum": 417,
      "people_in_more_than_one_business": 28
    },
    {
      "name": "plans_paid_active",
      "file": "metrics/plans_paid_active.yml",
      "question": "How many active subscriptions are for a paid plan?",
      "source": "data/model/fct_subscription.csv",
      "aggregation": "count of subscription_id",
      "filters": [
        "is_test_account = false",
        "status = active",
        "plan_tier \u2260 Free"
      ],
      "conditions": [
        {
          "column": "is_test_account",
          "equals": "false"
        },
        {
          "column": "status",
          "equals": "active"
        },
        {
          "column": "plan_tier",
          "not_equals": "Free"
        }
      ],
      "group_by": [
        "business_id",
        "plan_tier",
        "billing_cycle"
      ],
      "dimensions": [
        "business_id",
        "plan_tier",
        "billing_cycle"
      ],
      "notes": [
        "This is plans_active with Free removed.",
        "A Free plan with a zero price stays in plans_active and stays out of this metric.",
        "Use the governed plan_tier column."
      ],
      "cube": "data/cubes/plans_paid_active.json",
      "total": 310,
      "by_business": [
        {
          "id": "BIZ_1",
          "short": "PageGarden",
          "value": 94
        },
        {
          "id": "BIZ_2",
          "short": "GatherSquare",
          "value": 116
        },
        {
          "id": "BIZ_3",
          "short": "MakerHarbor",
          "value": 100
        }
      ]
    },
    {
      "name": "plan_starts",
      "file": "metrics/plan_starts.yml",
      "question": "How many subscriptions began within a certain date range?",
      "source": "data/model/fct_subscription.csv",
      "aggregation": "count of subscription_id",
      "filters": [
        "is_test_account = false",
        "start_date on or after 2026-01-01",
        "start_date on or before 2026-09-30"
      ],
      "conditions": [
        {
          "column": "is_test_account",
          "equals": "false"
        }
      ],
      "group_by": [
        "business_id",
        "plan_tier"
      ],
      "dimensions": [
        "business_id",
        "plan_tier",
        "start_date_month"
      ],
      "notes": [
        "A start counts even when the subscription is later canceled, paused, or unknown.",
        "The period is required. There is no default window.",
        "Take starts from start_date on this table. subscription_start events are a different count."
      ],
      "cube": "data/cubes/plan_starts.json",
      "total": 311,
      "parameters": {
        "period_start": "2026-01-01",
        "period_end": "2026-09-30"
      },
      "by_business": [
        {
          "id": "BIZ_1",
          "short": "PageGarden",
          "value": 99
        },
        {
          "id": "BIZ_2",
          "short": "GatherSquare",
          "value": 108
        },
        {
          "id": "BIZ_3",
          "short": "MakerHarbor",
          "value": 104
        }
      ]
    }
  ],
  "refusals": [
    {
      "id": "revenue",
      "title": "Revenue is not a metric",
      "body": "The catalog has no revenue, ARR, or cash metric. active monthly price on the model mart is a list-price total, and it is not in metrics/."
    },
    {
      "id": "completion",
      "title": "Completion rate is not a metric",
      "body": "Completes are not a subset of opens, so a completion rate is not defined. content_completes and content_opens are not in the catalog."
    },
    {
      "id": "identity",
      "title": "User-level fields stay off this site",
      "body": "email, user_name, and age_band are restricted. This page only returns a metric from metrics/."
    },
    {
      "id": "history",
      "title": "There is no point-in-time subscriber metric",
      "body": "status is the current value. A past date cannot be reconstructed from it. plan_starts counts subscriptions whose start_date falls in a period, which is a different question."
    },
    {
      "id": "events",
      "title": "Subscription events are not plan counts",
      "body": "subscription_start and subscription_cancel are engagement events. Plan metrics are counted from fct_subscription."
    },
    {
      "id": "period",
      "title": "That period is not in the catalog",
      "body": "plan_starts requires a period. The worked example on this page is 2026-01-01 through 2026-09-30. The dashboard lets you choose another range of start months."
    },
    {
      "id": "unknown",
      "title": "That question is not in the catalog",
      "body": "The page can answer plans_active, subscribers_active, plans_paid_active, plan_starts. It will not invent another metric."
    }
  ]
}
