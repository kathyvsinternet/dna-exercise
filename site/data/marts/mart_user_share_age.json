{
 "name": "mart_user_share_age",
 "sql": "SELECT\n  user_age_band,\n  COUNT(DISTINCT user_id) AS n_users,\n  ROUND(COUNT(DISTINCT user_id) / SUM(COUNT(DISTINCT user_id)) OVER (), 4) AS n_share\nFROM eph_user_info\nGROUP BY user_age_band\nORDER BY n_users DESC, user_age_band",
