{
 "name": "mart_user_share_channel",
 "sql": "SELECT\n  user_acq_channel,\n  COUNT(DISTINCT user_id) AS n_users,\n  ROUND(COUNT(DISTINCT user_id) / SUM(COUNT(DISTINCT user_id)) OVER (), 4) AS n_share\nFROM mart_user_info\nGROUP BY user_acq_channel\nORDER BY n_users DESC, user_acq_channel",
