{
 "name": "mart_growth_qtr_counts",
 "sql": "-- Here we calculate churn rate by looking at the previous quarter end's net subscriptions\n-- then we take the current quarter's cancellations and divide\n\nSELECT\n  quarter,\n  user_subscriptions,\n  user_cancellations,\n  SUM(user_subscriptions - user_cancellations) OVER thru_curr AS running_net_subscriptions,\n  ROUND(user_cancellations / NULLIF(SUM(user_subscriptions - user_cancellations) OVER pre_curr, 0), 4) AS quarterly_churn_rate\nFROM int_user_qtr_counts\nWINDOW\n  thru_curr AS (ORDER BY quarter), -- goes through existing row's quarter\n  pre_curr AS (ORDER BY quarter ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) -- ends at previous row's quarter\nORDER BY quarter",
 "depends_on": [
  "int_user_qtr_counts"
 ],
 "columns": [
  {
   "name": "quarter",
   "type": "DATE"
  },
  {
   "name": "user_subscriptions",
   "type": "HUGEINT"
  },
  {
   "name": "user_cancellations",
   "type": "HUGEINT"
  },
  {
   "name": "running_net_subscriptions",
   "type": "HUGEINT"
  },
  {
   "name": "quarterly_churn_rate",
   "type": "DOUBLE"
  }
 ],
