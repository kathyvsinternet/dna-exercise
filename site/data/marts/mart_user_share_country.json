{
 "name": "mart_user_share_country",
 "sql": "SELECT\n  user_geo_country,\n  COUNT(DISTINCT user_id) AS n_users,\n  ROUND(COUNT(DISTINCT user_id) / SUM(COUNT(DISTINCT user_id)) OVER (), 4) AS n_share\nFROM mart_user_info\nGROUP BY user_geo_country\nORDER BY n_users DESC, user_geo_country",
